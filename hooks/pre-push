#!/bin/bash
# Git pre-push hook：push 前自动运行代码审查
# 安装方法：复制到 .git/hooks/pre-push，chmod +x .git/hooks/pre-push

echo "🤖 代码审查 Agent 启动..."

# 获取项目根目录
PROJECT_ROOT=$(git rev-parse --show-toplevel)
AGENT_DIR="${AIAGENT_DIR:-$PROJECT_ROOT}"

# 运行审查
cd "$AGENT_DIR"
python review.py

# 审查结果不影响 push（返回 0）
# 如果希望审查不通过时阻止 push，取消下面注释：
# if [ $? -ne 0 ]; then
#     echo "审查未通过，push 已阻止"
#     exit 1
# fi

exit 0
