# ── LLM 配置 ─────────────────────────────────────
# 切换模型：修改下面三行，注释掉不用的

# DeepSeek（OpenAI 格式）
LLM_API_KEY=sk-xxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# MiMo OpenAI 格式（取消注释使用）
# LLM_API_KEY=your-mimo-key
# LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# LLM_MODEL=mimo-chat

# MiMo Anthropic 格式（取消注释使用）
# LLM_API_KEY=your-mimo-key
# LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
# LLM_MODEL=claude-sonnet-4-20250514

# 通义千问（取消注释使用）
# LLM_API_KEY=sk-xxxxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── MySQL（项目长期记忆）──────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aiagent

# ── GitHub（PR 评论）─────────────────────────────
GITHUB_TOKEN=ghp_xxxxx
GITHUB_REPO=  # 留空则自动从 git remote 检测

# ── PushPlus（微信推送）──────────────────────────
PUSHPLUS_TOKEN=xxxxx

# ── Agent 配置 ───────────────────────────────────
MAX_STEPS=15
MAX_TOOL_RETRIES=3
COMMAND_TIMEOUT=30
CONTEXT_MAX_TOKENS=8000
CONTEXT_WINDOW_SIZE=20
